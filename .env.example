# Docker Compose reads .env on the host and passes this only at runtime.
# Leave empty to use the simulated demo. Never commit a real API key.
BETFAIR_ODDS_API_KEY=
# Optional host port; the container always listens on 3000.
PORT=3000

# Optional research only; not consumed by the app or Compose service.
# Obtain privately. Saved reports do not require this credential.
ISPORTS_API_KEY=
